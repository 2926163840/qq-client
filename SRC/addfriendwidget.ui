/* 整体下拉框容器 */
QComboBox
{
    border:none;
    border-radius: 3px;
    background-color: #ffffff;
	placeholder-text-color:#999999;
	height:30px;
}
/* 下拉箭头按钮 */
QComboBox::drop-down
{
    border: none;
    width:30px;
}

QComboBox::down-arrow
{
	image: url(:/picture/downarrow.png);
	width:12px;
	height:12px;
}
QComboBox::down-arrow:on
{
	image: url(:/picture/uparrow.png);
}


/* 下拉弹出列表 */
QComboBox QAbstractItemView
{
	border-radius:6px;
    background: transparent;
    outline: none;
	padding:0px;
}
/* 下拉列表条目 */
QComboBox QAbstractItemView::item
{
    height: 30px;
	color:black;
	border-radius:6px;
	margin:2px;
}
QComboBox QAbstractItemView::item:hover
{
    background-color: #F5F5F5;
}
QComboBox QAbstractItemView::item:selected
{
    background-color: #E0E0E0;
}


/* 可编辑模式内置LineEdit */
QComboBox QLineEdit
{
    border:none;
    background:transparent;
}
#remarkedit{
	background-color:#FFFFFF;
	height:30px;
	border-radius:3px;

}
#AddFriendWidget{
	background-color:#F5F5F5;
}
#close{
	background:transparent;
}
#close:hover{
	background-color:#C42B1C;
}</string>
