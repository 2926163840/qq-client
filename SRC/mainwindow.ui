  <property name="styleSheet">
   <string notr="true">QPushButton{
	border-radius:8px;
}
QPushButton#passwordlogin{
	background-color:transparent;
	color:#2036ff;
}
QPushButton#registeruser{
	background-color:transparent;
	color:#2036ff;
}
QPushButton#login{
	background-color:#0099FF;
	color:#ffffff;
}
QPushButton#login:pressed{
	background-color:#0081D6;
	color:#40A1E0;
}
QPushButton#login:hover{
	background-color:#008DEB;
}
QLineEdit{
	border-radius:4px;
    background-color:#ffffff;
    border:1px solid #666666;
    color:black;
    font-size: 18px;
	placeholder-text-color:#999999;
	text-align:center;

}
QLineEdit:hover{
    border:1px solid #666666;
}
QLineEdit:focus{
    border:1px solid #666666;
    outline:none; 
}
/* 整体下拉框容器 */
QComboBox
{
    border: 1px solid #666666;
    border-radius: 6px;
    font-size: 18px;
    color: balck;
    background-color: #ffffff;
	placeholder-text-color:#999999;
	padding-left:35px;
}
/* 鼠标悬浮样式 */
QComboBox:hover
{
    border:1px solid #666666;
}
/* 点击聚焦样式 */
QComboBox:focus
{
    border:1px solid #666666;
    outline:none; }
/* 下拉箭头按钮 */
QComboBox::drop-down
{
    border: none;
    width:36px;
}

QComboBox::down-arrow
{
	image: url(:/picture/downarrow.png);
	width:12px;
	height:12px;
}
QComboBox::down-arrow:on
{
   
	image: url(:/picture/uparrow.png);
}


/* 下拉弹出列表 */
QComboBox QAbstractItemView
{
	border-radius:8px;
    background: transparent;
    outline: none;
	padding:0px;
}
/* 下拉列表条目 */
QComboBox QAbstractItemView::item
{
    height: 36px;
	color:black;
	border-radius:8px;
	margin:2px;
}
QComboBox QAbstractItemView::item:hover
{
    background-color: #F5F5F5;
}
QComboBox QAbstractItemView::item:selected
{
    background-color: #E0E0E0;
}


/* 可编辑模式内置LineEdit */
QComboBox QLineEdit
{
    border:none;
    background:transparent;
}</string>
