QPushButton#userfriend{
    color: #333333;
    border: none;
    background-color: #EBEBEB;
    padding: 6px 12px;
    font-size:12px;
}
QPushButton#userfriend:checked{
    color: #0C9EFF;
    border: 1px solid #0066ff;
    border-radius:3px;
}
QPushButton#userfriend:hover:!checked{
    color:#AEAEAE;
}
QPushButton#usergroup{
    color: #333333;
    border: none;
    background-color: #EBEBEB;
    padding: 6px 12px;
    font-size:12px;
}
QPushButton#usergroup:checked{
    color: #0C9EFF;
    border: 1px solid #0066ff;
    border-radius:3px;
}
QPushButton#usergroup:hover:!checked{
    color:#AEAEAE;
}
#switchbtn{
	background-color:#F5F5F5;
}


QTreeWidget {
	 show-decoration-selected: 1;
     background-color: #F5F5F5;
     border: none;
     outline: none;
}
/*去滚动条边角*/
QTreeWidget::corner {
    background: transparent;
    width:0px;
}
/* ==========分组（父节点：我的好友、特别关心）任何状态都不变色========== */
QTreeWidget::item:has-children {
    background-color: #F5F5F5;
    color: #333333;
    height:34px;
    padding-left:0px;
}
QTreeWidget::item:has-children:hover {
    background-color: #F5F5F5;
}
QTreeWidget::item:has-children:selected {
    background-color: #F5F5F5;
    color: #333333;
}

/* ==========好友子条目========== */
QTreeWidget::item:!has-children {
    background-color: #F5F5F5;
    color:#222222;
    height:36px;
    padding-left:0px;
}
QTreeWidget::item:!has-children:hover {
    background:transparent ;
}
QTreeWidget::item:!has-children:selected {
    background:transparents ;
    color:#222222;
}

/* 滚动条 */
QScrollBar:vertical {
    width:8px;
    background:transparent;
}
QScrollBar::handle:vertical {
    background-color: #cccccc;
    border-radius:4px;
}
QScrollBar::handle:vertical:hover {
    background-color:#aaaaaa;
}
QScrollBar::up-arrow:vertical, QScrollBar::down-arrow:vertical {
    width:0px;
    height:0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QTreeWidget::item
{
    border-bottom:1px solid #E8E8E8; /*分割线颜色*/
}
/* 去掉最后一条item多余底线（可选优化） */
QTreeWidget::item:last-child
{
    border-bottom:none;
}
QTextEdit {
    selection-background-color: transparent;
    selection-color: #000000;
    border: 1px solid #E0E0E0;
}
QTextEdit:focus {
    border: 1px solid #E0E0E0;
}</string>
